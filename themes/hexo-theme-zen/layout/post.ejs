<main>
    <% if (is_post()) { %>
    <h1>
        <%= page.title %>
    </h1>
    <% } %>
    <p>
        <i><time><%= date(page.date, 'YYYY/MM/DD HH:mm:ss' ) %></time></i>
        <% if (page.content) {
            var words = page.content.replace(/<[^>]*>/g, '').length;
            var min = Math.max(1, Math.round(words / 300));
        %>
        <span class="reading-time">· <%= min %> 分钟阅读</span>
        <% } %>
    </p>
    <% if (page.tags && page.tags.length) { %>
    <p class="post-tags">
        <% page.tags.each(function(tag) { %>
        <a class="tag-link" href="<%- url_for(tag.path) %>">#<%= tag.name %></a>
        <% }) %>
    </p>
    <% } %>
    <div class="post-content">
        <%- page.content %>
    </div>
    <nav class="post-nav">
        <% if (page.prev) { %>
        <a class="post-nav-prev" href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a>
        <% } %>
        <% if (page.next) { %>
        <a class="post-nav-next" href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a>
        <% } %>
    </nav>
    <% if (page.tags && page.tags.length) { %>
    <div class="related-posts">
        <h3>相关文章</h3>
        <% var related = []; %>
        <% site.posts.each(function(p) { %>
            <% if (p._id !== page._id && p.tags && p.tags.length) { %>
                <% var shared = []; %>
                <% p.tags.each(function(t) { %>
                    <% page.tags.each(function(pt) { if (pt.name === t.name) shared.push(t); }); %>
                <% }); %>
                <% if (shared.length > 0) related.push({post: p, count: shared.length}); %>
            <% } %>
        <% }); %>
        <% related.sort(function(a,b){return b.count-a.count;}).slice(0,5).forEach(function(r) { %>
        <a class="related-link" href="<%- url_for(r.post.path) %>"><%- r.post.title %></a>
        <% }); %>
        <% if (related.length === 0) { %><p class="empty-related">暂无相关文章</p><% } %>
    </div>
    <% } %>
    <% if (theme.twikoo.enable || false) { %>
        <%- partial('components/twikoo') %>
    <% } %>
    <% if (theme.beaudar.enable || false) { %>
        <%- partial('components/beaudar') %>
    <% } %>
</main>
