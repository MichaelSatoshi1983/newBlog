<%
    var commitSha = process.env.WORKERS_CI_COMMIT_SHA || '';
    var hasCommitSha = /^[a-f0-9]{40}$/i.test(commitSha);
%>
<main class="about-website">
    <h1><%= page.title %></h1>
    <div class="post-content">
        <label class="trace-range" for="analytics-range">统计时间范围：
            <select id="analytics-range">
                <option value="24h">近24小时</option>
                <option value="7d">近7天</option>
                <option value="30d">近30天</option>
            </select>
        </label>
        <ul id="trace-list" class="trace-list" aria-label="Cloudflare Trace 信息" data-version="<%= hasCommitSha ? commitSha : '' %>"></ul>
    </div>
</main>
<style>
    .trace-list {
        list-style: none;
        margin: 1rem 0;
        padding: 0;
    }
    .trace-list li {
        padding: 0.45em 0.75em;
        border-bottom: 1px solid var(--border-color);
        overflow-wrap: anywhere;
    }
    .trace-list li:nth-child(odd) { background: var(--surface-color); }
    .trace-range {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        margin-top: 0.75rem;
    }
    .trace-range select {
        padding: 0.35em 0.55em;
        color: inherit;
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: 0.35em;
        font: inherit;
    }
</style>
<script defer src="<%- url_for('js/cf-trace.js') %>"></script>
