<footer style="padding:25px 0;">
    <% if (theme.friends && theme.friends.length > 0) { %>
        <% for (index in theme.friends) { %>
            <% if (index !== '0') { %>
                <span> | </span>
            <% } %>
            <span>
                <a href="<%= theme.friends[index].url %>"><%= theme.friends[index].name %></a>
            </span>
        <% } %>
    <% } %>
    <br/>
    <% if (theme.copyright) { %>
    <span>
        &copy; <%= date(new Date(), 'YYYY' ) %>
            <%= theme.copyright.name || config.author %>
    </span>
    <% } %>
    <span>
        Powered by <a href="https://hexo.io/">Hexo</a>
    </span>
    <span>
        Theme <a href="https://github.com/mouyase/hexo-theme-zen">Zen</a>
    </span>
    <span id="cdn-node"></span>
</footer>
<script>
    (function () {
        function loadCdnNode() {
            fetch('/cdn-cgi/trace').then(function (r) { return r.text(); }).then(function (t) {
                var match = t.match(/colo=(\w+)/);
                if (match) document.getElementById('cdn-node').textContent = ' | CDN: ' + match[1];
            }).catch(function () {});
        }

        var footer = document.querySelector('footer');
        if (!footer || !('IntersectionObserver' in window)) {
            loadCdnNode();
            return;
        }

        var observer = new IntersectionObserver(function (entries) {
            if (!entries.some(function (entry) { return entry.isIntersecting; })) return;
            observer.disconnect();
            loadCdnNode();
        }, { rootMargin: '150px' });
        observer.observe(footer);
    })();
</script>